# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- required ---
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# --- database ---
POSTGRES_DB=pantau
POSTGRES_USER=pantau

# --- web ---
# Hostnames this deployment answers to. "*" is rejected when DEBUG is off: a wildcard
# turns off Host-header validation, which is what enables poisoned password-reset links.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8000

# Behind a TLS terminator, name the https origin here or Django rejects every POST:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://pantau.go.id
DJANGO_CSRF_TRUSTED_ORIGINS=

# "TLS terminates in front of this app." Drives the https redirect, the Secure flag on
# the session/CSRF cookies, and HSTS — they are only correct together. 0 for local http
# (compose has no TLS terminator); set to 1 in any real deployment.
DJANGO_BEHIND_TLS=0

# Seeds fabricated mentions and political actors. Useful for a demo; in a real
# deployment this is indistinguishable from genuine intelligence on the dashboard.
SEED_DEMO_DATA=0

# Optional deployment-wide fallback for social/history collection. A project-level
# credential saved in Konfigurasi takes precedence. APIFY_API_TOKEN is preferred;
# APIFY_KEY is retained as a compatible alias.
APIFY_API_TOKEN=
# APIFY_KEY=

# --- email alerts and daily briefs (optional) ---
# Leave the console backend in local development. The application records those
# attempts as skipped, never as delivered.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=pantau@example.go.id

# --- real NLP enrichment (optional) ---
# OpenAI-compatible chat-completions endpoint. The same values can be managed in
# Dev/Ops as nlp.api_url, nlp.model, nlp.api_key (secret), nlp.timeout_seconds.
NLP_API_URL=
NLP_API_KEY=
NLP_MODEL=
NLP_TIMEOUT_SECONDS=30

# --- browser push alerts (optional) ---
# VAPID contact must be a mailto: or https: URI.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CONTACT=mailto:ops@example.go.id

# --- gunicorn (optional; sensible defaults in gunicorn.conf.py) ---
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
