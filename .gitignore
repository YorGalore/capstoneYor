.venv/
__pycache__/
*.pyc
db.sqlite3
.superpowers/

# Real secrets: the deployment's SECRET_KEY and Postgres password. .env.example is the
# committed template.
.env

# Build output of collectstatic.
staticfiles/

# Reference material dropped into the repo (SRS source documents, screenshots). Kept out
# of history deliberately: they are large binaries that git cannot diff, and they are
# inputs to the work rather than part of it.
*.docx
*.pdf
*.jpeg
*.jpg

# Server access notes. These carry live hostnames, credentials, and private-key
# paths, and must never enter history — a leaked deploy key is a rotation, not a
# revert.
*vps*.txt
docs/*credentials*
docs/*secrets*
